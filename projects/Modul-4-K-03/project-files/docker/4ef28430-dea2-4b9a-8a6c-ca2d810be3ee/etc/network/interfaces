# Network configuration for Schumann
# Script equivalent also available at /root/schumann.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.36
	netmask 255.255.255.248
	gateway 10.65.16.33
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.16.41
	netmask 255.255.255.248

auto eth2
iface eth2 inet static
	address 10.65.16.61
	netmask 255.255.255.252
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.4.0/22 via 10.65.16.62 dev eth2
	up ip route add 10.65.0.0/22 via 10.65.16.34 dev eth0
	up ip route add 10.65.8.0/23 via 10.65.16.35 dev eth0
	up ip route add 10.65.15.192/26 via 10.65.16.35 dev eth0

