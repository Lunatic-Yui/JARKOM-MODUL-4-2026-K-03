# Network configuration for Knights
# Script equivalent also available at /root/knights.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.82
	netmask 255.255.255.252
	gateway 10.65.16.81
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.16.49
	netmask 255.255.255.248

auto eth2
iface eth2 inet static
	address 10.65.16.85
	netmask 255.255.255.252
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.15.0/26 via 10.65.16.86 dev eth2
	up ip route add 10.65.16.0/27 via 10.65.16.86 dev eth2
	up ip route add 10.65.16.88/30 via 10.65.16.86 dev eth2

