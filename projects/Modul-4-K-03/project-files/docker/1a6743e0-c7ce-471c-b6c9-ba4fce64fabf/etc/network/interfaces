# Network configuration for Protocol7
# Script equivalent also available at /root/protocol7.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.78
	netmask 255.255.255.252
	gateway 10.65.16.77
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.15.129
	netmask 255.255.255.192

auto eth2
iface eth2 inet static
	address 10.65.16.81
	netmask 255.255.255.252
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.15.0/26 via 10.65.16.82 dev eth2
	up ip route add 10.65.16.0/27 via 10.65.16.82 dev eth2
	up ip route add 10.65.16.48/29 via 10.65.16.82 dev eth2
	up ip route add 10.65.16.84/30 via 10.65.16.82 dev eth2
	up ip route add 10.65.16.88/30 via 10.65.16.82 dev eth2

