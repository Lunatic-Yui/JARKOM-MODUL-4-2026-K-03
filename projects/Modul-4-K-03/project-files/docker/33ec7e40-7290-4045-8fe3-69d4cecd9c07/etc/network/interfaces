# Network configuration for Wired
# Script equivalent also available at /root/wired.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.58
	netmask 255.255.255.252
	gateway 10.65.16.57
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.16.33
	netmask 255.255.255.248

auto eth2
iface eth2 inet static
	address 10.65.16.65
	netmask 255.255.255.252

auto eth3
iface eth3 inet static
	address 10.65.16.69
	netmask 255.255.255.252
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.0.0/22 via 10.65.16.34 dev eth1
	up ip route add 10.65.8.0/23 via 10.65.16.35 dev eth1
	up ip route add 10.65.15.192/26 via 10.65.16.35 dev eth1
	up ip route add 10.65.4.0/22 via 10.65.16.36 dev eth1
	up ip route add 10.65.16.40/29 via 10.65.16.36 dev eth1
	up ip route add 10.65.16.60/30 via 10.65.16.36 dev eth1
	up ip route add 10.65.12.0/24 via 10.65.16.66 dev eth2
	up ip route add 10.65.13.0/24 via 10.65.16.66 dev eth2
	up ip route add 10.65.15.64/26 via 10.65.16.66 dev eth2
	up ip route add 10.65.10.0/23 via 10.65.16.70 dev eth3
	up ip route add 10.65.14.128/25 via 10.65.16.70 dev eth3
	up ip route add 10.65.15.0/26 via 10.65.16.70 dev eth3
	up ip route add 10.65.15.128/26 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.0/27 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.48/29 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.72/30 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.76/30 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.80/30 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.84/30 via 10.65.16.70 dev eth3
	up ip route add 10.65.16.88/30 via 10.65.16.70 dev eth3

