# Network configuration for Phantoma
# Script equivalent also available at /root/phantoma.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.86
	netmask 255.255.255.252
	gateway 10.65.16.85
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.16.1
	netmask 255.255.255.224

auto eth2
iface eth2 inet static
	address 10.65.16.89
	netmask 255.255.255.252
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.15.0/26 via 10.65.16.90 dev eth2

