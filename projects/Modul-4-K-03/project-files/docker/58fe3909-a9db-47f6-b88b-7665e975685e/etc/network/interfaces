# Network configuration for Copland
# Script equivalent also available at /root/copland.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.35
	netmask 255.255.255.248
	gateway 10.65.16.33
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.15.193
	netmask 255.255.255.192

auto eth2
iface eth2 inet static
	address 10.65.8.1
	netmask 255.255.254.0
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.0.0/22 via 10.65.16.34 dev eth0
	up ip route add 10.65.4.0/22 via 10.65.16.36 dev eth0
	up ip route add 10.65.16.40/29 via 10.65.16.36 dev eth0
	up ip route add 10.65.16.60/30 via 10.65.16.36 dev eth0

