# Network configuration for Tachibana
# Script equivalent also available at /root/tachibana.sh

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address 10.65.16.70
	netmask 255.255.255.252
	gateway 10.65.16.69
	up echo nameserver 8.8.8.8 > /etc/resolv.conf

auto eth1
iface eth1 inet static
	address 10.65.10.1
	netmask 255.255.254.0

auto eth2
iface eth2 inet static
	address 10.65.16.73
	netmask 255.255.255.252
	up sysctl -w net.ipv4.ip_forward=1
	up ip route add 10.65.14.128/25 via 10.65.16.74 dev eth2
	up ip route add 10.65.15.0/26 via 10.65.16.74 dev eth2
	up ip route add 10.65.15.128/26 via 10.65.16.74 dev eth2
	up ip route add 10.65.16.0/27 via 10.65.16.74 dev eth2
	up ip route add 10.65.16.48/29 via 10.65.16.74 dev eth2
	up ip route add 10.65.16.76/30 via 10.65.16.74 dev eth2
	up ip route add 10.65.16.80/30 via 10.65.16.74 dev eth2
	up ip route add 10.65.16.84/30 via 10.65.16.74 dev eth2
	up ip route add 10.65.16.88/30 via 10.65.16.74 dev eth2

